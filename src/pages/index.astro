---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Home">
  <Header />
  
  <!-- Hero Section -->
  <section id="home" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-primary-100 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950 transition-colors duration-300"></div>
    <div class="absolute inset-0 opacity-30 dark:opacity-20 hidden sm:block">
      <div class="absolute top-20 right-10 md:right-20 w-48 md:w-72 lg:w-96 h-48 md:h-72 lg:h-96 bg-primary-300 dark:bg-primary-700 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-3xl animate-blob"></div>
      <div class="absolute bottom-20 left-10 md:left-20 w-48 md:w-72 lg:w-96 h-48 md:h-72 lg:h-96 bg-primary-200 dark:bg-primary-800 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 w-32 md:w-48 lg:w-72 h-32 md:h-48 lg:h-72 bg-primary-400 dark:bg-primary-600 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-3xl animate-blob animation-delay-4000"></div>
    </div>

    <!-- Floating graphic design elements -->
    <div class="absolute inset-0 pointer-events-none hidden lg:block">
      <!-- Pen tool icon -->
      <svg class="absolute top-32 left-16 w-12 h-12 text-primary-300 dark:text-primary-600 opacity-60 animate-float" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
      <!-- Color palette -->
      <div class="absolute top-44 right-24 flex gap-2 animate-float-delay">
        <div class="w-6 h-6 rounded-full bg-primary-400 animate-swatch shadow-lg"></div>
        <div class="w-6 h-6 rounded-full bg-primary-600 animate-swatch-delay shadow-lg"></div>
        <div class="w-6 h-6 rounded-full bg-primary-800 animate-swatch-delay-2 shadow-lg"></div>
      </div>
      <!-- Bezier curve -->
      <svg class="absolute bottom-40 right-32 w-24 h-24 text-primary-200 dark:text-primary-700 opacity-50 animate-float" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 90 C 30 10, 70 10, 90 90" stroke-linecap="round"/>
        <circle cx="10" cy="90" r="4" fill="currentColor"/>
        <circle cx="90" cy="90" r="4" fill="currentColor"/>
      </svg>
      <!-- Grid/rulers -->
      <svg class="absolute bottom-32 left-20 w-16 h-16 text-primary-300 dark:text-primary-700 opacity-40 animate-float-delay" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
      </svg>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center">
        <div class="inline-block mb-6 animate-fade-in">
          <span class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-primary-700 dark:text-primary-400 px-5 py-2.5 rounded-full text-sm font-medium shadow-lg border border-primary-100 dark:border-primary-800">
            ✨ Grafica Personalizzata di Alta Qualità
          </span>
        </div>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold mb-6 animate-fade-in-up">
          <span class="gradient-text">Trasforma</span> la tua<br />
          <span class="text-gray-900 dark:text-white">visione in realtà</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-10 leading-relaxed animate-fade-in-up animation-delay-200">
          Ciao, sono <span class="font-semibold text-primary-600 dark:text-primary-400">Desiree Tropini</span>. 
          Creo identità visive uniche e memorabili che raccontano la storia del tuo brand.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up animation-delay-400">
          <a href="#contatti" class="group bg-gradient-to-r from-primary-500 to-primary-600 text-white px-8 py-4 rounded-full font-semibold text-lg shadow-xl hover:shadow-2xl hover:scale-105 transition-all transform">
            Inizia un Progetto
            <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a href="#servizi" class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-primary-600 dark:text-primary-400 border-2 border-primary-300 dark:border-primary-700 px-8 py-4 rounded-full font-semibold text-lg hover:bg-white dark:hover:bg-gray-800 hover:border-primary-500 transition-all shadow-lg">
            Scopri i Servizi
          </a>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <div class="w-6 h-10 border-2 border-primary-400 dark:border-primary-500 rounded-full flex justify-center pt-2">
        <div class="w-1.5 h-3 bg-primary-400 dark:bg-primary-500 rounded-full animate-scroll"></div>
      </div>
    </div>
  </section>

  <!-- Chi Sono Section -->
  <section id="chi-sono" class="py-16 md:py-24 bg-white dark:bg-gray-950 relative overflow-hidden transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center reveal">
        <div class="relative order-2 lg:order-1">
          <div class="absolute -top-4 -left-4 md:-top-6 md:-left-6 w-full h-full bg-gradient-to-br from-primary-400 to-primary-600 rounded-2xl md:rounded-3xl transform rotate-2 md:rotate-3"></div>
          <div class="relative bg-gradient-to-br from-primary-100 to-primary-200 rounded-2xl md:rounded-3xl overflow-hidden aspect-[4/5] shadow-2xl">
            <img src="https://images.unsplash.com/photo-1626785774573-4b799315345d?w=600&h=750&fit=crop" 
                 alt="Studio di Graphic Design Professionale" 
                 class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
          </div>
          <div class="absolute -bottom-4 right-4 md:-bottom-6 md:-right-6 lg:-bottom-8 lg:-right-8 bg-white dark:bg-gray-800 rounded-xl md:rounded-2xl p-4 md:p-6 shadow-2xl border border-primary-100 dark:border-primary-800">
            <div class="flex items-center gap-3 md:gap-4">
              <div class="w-10 h-10 md:w-14 md:h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center">
                <span class="text-white font-bold text-base md:text-xl">5+</span>
              </div>
              <div>
                <p class="font-display font-bold text-gray-900 dark:text-white text-sm md:text-base">Anni di</p>
                <p class="text-primary-600 font-semibold text-sm md:text-base">Esperienza</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="lg:pl-8 order-1 lg:order-2 text-center lg:text-left">
          <span class="text-primary-600 dark:text-primary-400 font-semibold text-sm uppercase tracking-wider">Chi Sono</span>
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold mt-3 mb-6">
            Creo <span class="gradient-text">esperienze visive</span> che lasciano il segno
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
            Sono Desiree Tropini, una graphic designer appassionata con oltre 5 anni di esperienza nel creare identità visive uniche per brand che vogliono distinguersi.
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-8">
            Il mio approccio combina creatività, strategia e attenzione ai dettagli per trasformare le tue idee in design memorabili che comunicano i valori del tuo brand.
          </p>
          <div class="grid grid-cols-2 gap-6 mb-8">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-primary-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <span class="font-medium text-gray-900 dark:text-white">100+ Progetti</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-primary-100 dark:bg-primary-900/50 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <span class="font-medium text-gray-900 dark:text-white">50+ Clienti Felici</span>
            </div>
          </div>
          <a href="#contatti" class="inline-flex items-center gap-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-6 py-3 rounded-full font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors">
            Parliamo del tuo progetto
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servizi Section -->
  <section id="servizi" class="py-16 md:py-24 bg-gradient-to-b from-white to-primary-50 dark:from-gray-950 dark:to-gray-900 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <span class="text-primary-600 dark:text-primary-400 font-semibold text-sm uppercase tracking-wider">I Miei Servizi</span>
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold mt-3 mb-4">
          Soluzioni <span class="gradient-text">su misura</span> per te
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Ogni progetto è unico. Offro servizi personalizzati per rispondere alle esigenze specifiche del tuo brand.
        </p>
      </div>
      
      <!-- Main Service -->
      <div class="mb-16">
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-2xl overflow-hidden border border-primary-100 dark:border-primary-800 reveal gfx-border">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="p-8 lg:p-12 flex flex-col justify-center">
              <div class="inline-flex items-center gap-2 bg-primary-100 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300 px-4 py-2 rounded-full text-sm font-medium mb-6 w-fit">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
                Servizio Premium
              </div>
              <h3 class="font-display text-3xl lg:text-4xl font-bold mb-4 text-gray-900 dark:text-white">Brand Identity Completa</h3>
              <p class="text-lg text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                Un pacchetto completo per creare l'identità visiva del tuo brand da zero: logo, palette colori, tipografia, pattern, icone e un manuale d'uso dettagliato.
              </p>
              <ul class="space-y-3 mb-8">
                <li class="flex items-center gap-3 text-gray-700 dark:text-gray-300">
                  <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  Logo design con varianti
                </li>
                <li class="flex items-center gap-3 text-gray-700 dark:text-gray-300">
                  <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  Palette colori e tipografia
                </li>
                <li class="flex items-center gap-3 text-gray-700 dark:text-gray-300">
                  <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  Brand guidelines complete
                </li>
              </ul>
              <a href="#contatti" class="inline-flex items-center gap-2 bg-gradient-to-r from-primary-500 to-primary-600 text-white px-6 py-3 rounded-full font-semibold hover:shadow-lg transition-all w-fit">
                Richiedi preventivo
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
            <div class="relative h-64 lg:h-auto">
              <img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?w=800&h=600&fit=crop" 
                   alt="Brand Identity Design" 
                   class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-primary-600/20 to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Other Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal">
        <div class="group bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-2xl transition-all border border-gray-100 dark:border-gray-700 hover:border-primary-200 dark:hover:border-primary-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-primary-100 dark:from-primary-900/30 to-transparent rounded-bl-full"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-bold mb-3 text-gray-900 dark:text-white">Social Media Graphics</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Contenuti visivi accattivanti per Instagram, Facebook, LinkedIn e altre piattaforme.
            </p>
            <a href="#contatti" class="text-primary-600 dark:text-primary-400 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri di più
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="group bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-2xl transition-all border border-gray-100 dark:border-gray-700 hover:border-primary-200 dark:hover:border-primary-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-primary-100 dark:from-primary-900/30 to-transparent rounded-bl-full"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-bold mb-3 text-gray-900 dark:text-white">Materiali Stampati</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Biglietti da visita, brochure, flyer, cataloghi e tutto per la stampa professionale.
            </p>
            <a href="#contatti" class="text-primary-600 dark:text-primary-400 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri di più
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="group bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-2xl transition-all border border-gray-100 dark:border-gray-700 hover:border-primary-200 dark:hover:border-primary-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-primary-100 dark:from-primary-900/30 to-transparent rounded-bl-full"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-bold mb-3 text-gray-900 dark:text-white">Web Design</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Design di interfacce web moderne, responsive e user-friendly per il tuo sito.
            </p>
            <a href="#contatti" class="text-primary-600 dark:text-primary-400 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri di più
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="group bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-2xl transition-all border border-gray-100 dark:border-gray-700 hover:border-primary-200 dark:hover:border-primary-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-primary-100 dark:from-primary-900/30 to-transparent rounded-bl-full"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
            </div>
            <h3 class="font-display text-xl font-bold mb-3 text-gray-900 dark:text-white">Packaging Design</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Design di packaging accattivante che fa risaltare i tuoi prodotti sugli scaffali.
            </p>
            <a href="#contatti" class="text-primary-600 dark:text-primary-400 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri di più
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="group bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-2xl transition-all border border-gray-100 dark:border-gray-700 hover:border-primary-200 dark:hover:border-primary-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-primary-100 dark:from-primary-900/30 to-transparent rounded-bl-full"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl font-bold mb-3 text-gray-900 dark:text-white">Motion Graphics</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Animazioni e video grafici per rendere i tuoi contenuti più dinamici e coinvolgenti.
            </p>
            <a href="#contatti" class="text-primary-600 dark:text-primary-400 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri di più
