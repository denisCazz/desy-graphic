---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Servizi di grafica personalizzata di alta qualità per il tuo brand" } = Astro.props;
---

<!doctype html>
<html lang="it" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Desiree Tropini - Grafica Personalizzata</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600;1,700&family=Lora:ital,wght@1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.replace('light', 'dark');
      }
    </script>
  </head>
  <body class="text-gray-800 dark:text-gray-200 bg-white dark:bg-gray-950 leading-relaxed transition-colors duration-300">
    <slot />
  </body>
</html>
