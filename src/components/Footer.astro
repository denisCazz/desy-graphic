            </svg>
          </a>
        </div>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h3 class="font-display font-bold text-lg mb-6">Link Rapidi</h3>
        <ul class="space-y-4">
          <li>
            <a href="#home" class="text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Home
            </a>
          </li>
          <li>
            <a href="#chi-sono" class="text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Chi Sono
            </a>
          </li>
          <li>
            <a href="#servizi" class="text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Servizi
            </a>
          </li>
          <li>
            <a href="#portfolio" class="text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Portfolio
            </a>
          </li>
          <li>
            <a href="#contatti" class="text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Contatti
            </a>
          </li>
        </ul>
      </div>
      
      <!-- Contact -->
      <div>
        <h3 class="font-display font-bold text-lg mb-6">Contatti</h3>
        <ul class="space-y-4">
          <li>
            <a href="mailto:info@desireetropini.it" class="text-gray-400 hover:text-primary-400 transition-colors flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              info@desireetropini.it
            </a>
          </li>
          <li class="flex items-start gap-3 text-gray-400">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Italia - Lavoro da remoto
          </li>
          <li class="flex items-start gap-3 text-gray-400">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Risposta entro 24h
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 py-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-500 text-sm">
          © {currentYear} Desiree Tropini. Tutti i diritti riservati.
        </p>
        <p class="text-gray-500 text-sm">
          Made with <span class="text-primary-500">♥</span> in Italy
        </p>
      </div>
    </div>
  </div>
</footer>
