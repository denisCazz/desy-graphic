---
const reviews: {
  name: string;
  role: string;
  quote: string;
  rating: number;
  avatar?: string;
}[] = [
  // Per aggiungere recensioni reali, inserire oggetti qui:
  // {
  //   name: "Nome Cliente",
  //   role: "Ruolo, Azienda",
  //   quote: "Testo della recensione...",
  //   rating: 5,
  //   avatar: "https://url-foto-cliente.jpg" // opzionale
  // },
];
---

<!-- Testimonials Section -->
<section id="recensioni" class="py-16 md:py-24 bg-gradient-to-b from-primary-50 to-white dark:from-gray-900 dark:to-gray-950 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-primary-600 dark:text-primary-400 font-semibold text-sm uppercase tracking-wider">Recensioni</span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold mt-3 mb-4">
        Cosa dicono i <span class="gradient-text">clienti</span>
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        La soddisfazione dei miei clienti è la mia migliore referenza
      </p>
    </div>

    {reviews.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal">
        {reviews.map((review, i) => (
          <div class="review-card bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-xl border border-gray-100 dark:border-gray-700 relative hover:shadow-2xl transition-all duration-300" style={`--stagger: ${i}`}>
            <div class="absolute -top-4 left-8 w-8 h-8 bg-primary-500 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
            <div class="flex items-center mb-4 mt-4">
              {Array.from({ length: 5 }).map((_, s) => (
                <svg class={`w-5 h-5 ${s < review.rating ? 'text-yellow-400' : 'text-gray-300 dark:text-gray-600'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-gray-600 dark:text-gray-400 mb-6 italic leading-relaxed">
              "{review.quote}"
            </p>
            <div class="flex items-center gap-4">
              {review.avatar ? (
                <img src={review.avatar} alt={review.name} class="w-12 h-12 rounded-full object-cover ring-2 ring-primary-200 dark:ring-primary-700" loading="lazy" decoding="async" />
              ) : (
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center ring-2 ring-primary-200 dark:ring-primary-700">
                  <span class="text-white font-bold text-lg">{review.name.charAt(0)}</span>
                </div>
              )}
              <div>
                <p class="font-semibold text-gray-900 dark:text-white">{review.name}</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">{review.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="reveal">
        <div class="max-w-2xl mx-auto text-center">
          <div class="bg-white dark:bg-gray-800 rounded-3xl p-10 md:p-14 shadow-xl border border-gray-100 dark:border-gray-700 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600"></div>
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-primary-100 dark:bg-primary-900/20 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-primary-50 dark:bg-primary-900/10 rounded-full blur-3xl"></div>
            <div class="relative">
              <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/50 dark:to-primary-800/50 rounded-2xl flex items-center justify-center">
                <svg class="w-10 h-10 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
                </svg>
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-3">
                Le recensioni arriveranno presto
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-lg mb-8 max-w-md mx-auto leading-relaxed">
                Sto raccogliendo i feedback dei miei clienti. Vuoi essere il primo a lasciare una recensione?
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="https://wa.me/393519586139?text=Ciao%20Desiree!%20Vorrei%20lasciare%20una%20recensione%20sul%20tuo%20lavoro."
                   target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1ebe57] text-white px-6 py-3 rounded-full font-semibold shadow-lg hover:shadow-xl hover:scale-105 transition-all">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  Lascia una recensione
                </a>
                <a href="mailto:d.tropini@bitora.it?subject=Recensione%20per%20Desiree%20Tropini"
                   class="inline-flex items-center justify-center gap-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white border-2 border-gray-200 dark:border-gray-600 px-6 py-3 rounded-full font-semibold hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-lg hover:scale-105 transition-all">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  Scrivi via email
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
